          "level": "warning",
          "message": {
            "text": "Webhook response mode exposes internals: Webhook responseMode='lastNode' - the last node's full output (possibly including credentials, internal IDs, stack traces) is returned to the unauthenticated caller. Fix: Return an explicit minimal payload via the Respond to Webhook node."
          },
          "locations": [
            {
