        },
        {
          "ruleId": "FS010",
          "level": "warning",
          "message": {
            "text": "Missing error handling on workflow: Workflow has no errorWorkflow setting and no Error Trigger node. Failures (and the data inside them) go nowhere visible. Fix: Attach an error workflow in Settings > Error Workflow, or add an Error Trigger workflow that alerts a human."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/real/anaamrasool_whatsapp-bot.json"
