{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "FlowSentry",
          "version": "0.1.0",
          "informationUri": "https://github.com/vasilicasijarvis/flowsentry",
          "rules": [
            {
              "id": "FS001",
              "name": "Webhookendpointwithoutauthentication",
              "shortDescription": {
                "text": "Webhook endpoint without authentication"
              },
              "fullDescription": {
                "text": "Webhook endpoint without authentication"
              },
              "help": {
                "text": "OWASP Agentic mapping: A01 Agent Identity Abuse"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "FS005",
              "name": "ExecuteCommandnodewithoutguardrails",
              "shortDescription": {
                "text": "Execute Command node without guardrails"
              },
              "fullDescription": {
                "text": "Execute Command node without guardrails"
              },
              "help": {
                "text": "OWASP Agentic mapping: A03 Shell Injection"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "FS006",
              "name": "Codenodewithoutsandboxhardening",
              "shortDescription": {
                "text": "Code node without sandbox hardening"
              },
              "fullDescription": {
                "text": "Code node without sandbox hardening"
              },
              "help": {
                "text": "OWASP Agentic mapping: A03 Code Injection"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "FS009",
              "name": "Expression-basedcommandinjection",
              "shortDescription": {
                "text": "Expression-based command injection"
              },
              "fullDescription": {
                "text": "Expression-based command injection"
              },
              "help": {
                "text": "OWASP Agentic mapping: A03 Shell Injection"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "FS010",
              "name": "Missingerrorhandlingonworkflow",
              "shortDescription": {
                "text": "Missing error handling on workflow"
              },
              "fullDescription": {
                "text": "Missing error handling on workflow"
              },
              "help": {
                "text": "OWASP Agentic mapping: A06 Memory & Data Exposure"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "FS014",
              "name": "Credentialreuseacrossmanynodes",
              "shortDescription": {
                "text": "Credential reuse across many nodes"
              },
              "fullDescription": {
                "text": "Credential reuse across many nodes"
              },
              "help": {
                "text": "OWASP Agentic mapping: A02 Excessive Agency"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "FS017",
              "name": "Webhookresponsemodeexposesinternals",
              "shortDescription": {
                "text": "Webhook response mode exposes internals"
              },
              "fullDescription": {
                "text": "Webhook response mode exposes internals"
              },
              "help": {
                "text": "OWASP Agentic mapping: A06 Memory & Data Exposure"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "FS001",
          "level": "error",
          "message": {
            "text": "Webhook endpoint without authentication: Webhook node has authentication set to 'none'. Anyone who can reach the n8n instance can trigger this workflow and its downstream actions. Fix: Set Webhook > Authentication to Basic/Header/JWT auth, or validate a shared-secret header in the workflow before doing anything sensitive."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/real/anaamrasool_whatsapp-bot.json"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "Webhook WhatsApp"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "FS006",
          "level": "warning",
          "message": {
            "text": "Code node without sandbox hardening: Code node present (mode=runOnceForAllItems). Custom code runs inside n8n; in 'runOnceForAllItems' JS mode with task runners disabled it can reach the host environment. Fix: Enable N8N_RUNNERS_ENABLED=true (task runners sandbox), keep code reviewed in version control, and avoid importing os/child_process."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/real/anaamrasool_whatsapp-bot.json"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "Extract Message"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "FS006",
          "level": "warning",
          "message": {
            "text": "Code node without sandbox hardening: Code node present (mode=runOnceForAllItems). Custom code runs inside n8n; in 'runOnceForAllItems' JS mode with task runners disabled it can reach the host environment. Fix: Enable N8N_RUNNERS_ENABLED=true (task runners sandbox), keep code reviewed in version control, and avoid importing os/child_process."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
